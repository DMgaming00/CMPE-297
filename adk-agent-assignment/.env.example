# Copy to .env and fill in values. Never commit .env.
# All values below are PLACEHOLDERS.

# --- Gemini / Vertex AI -------------------------------------------------------
# Option 1: Gemini API key (AI Studio)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=your-gemini-api-key
# Option 2: Vertex AI (set GOOGLE_GENAI_USE_VERTEXAI=true and run
#   gcloud auth application-default login)
# GOOGLE_GENAI_USE_VERTEXAI=true

GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_ADVANCED_MODEL=gemini-3.8-flash

# --- Google Cloud -------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Gemini CLI (Agent B) -----------------------------------------------------
GEMINI_CLI_PATH=gemini
GEMINI_CLI_MODEL=
GEMINI_CLI_TIMEOUT_SECONDS=300
GEMINI_CLI_MAX_CONCURRENCY=2
GEMINI_CLI_SANDBOX=false

# --- MCP (Agents C and E) -----------------------------------------------------
# local = repository MCP servers over stdio (SQLite storage)
# toolbox = MCP Toolbox for Databases (PostgreSQL / AlloyDB)
BUG_TRACKER_BACKEND=local
ECOMMERCE_BACKEND=local
TOOLBOX_URL=http://127.0.0.1:5000
# Optional read-only GitHub MCP server for Agent C
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Database (production / Toolbox) -----------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=store
DB_USER=app_user
DB_PASSWORD=change-me
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# --- Local development --------------------------------------------------------
LOCAL_STATE_DIR=.local_state
ECOMMERCE_DEMO_CUSTOMER_ID=cust-alice
LOG_LEVEL=INFO
