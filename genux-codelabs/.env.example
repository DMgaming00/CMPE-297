# Everything works offline with the scripted mock model. Leave these blank to stay offline.
# Optional: use a real OpenAI-compatible chat-completions endpoint for the harness (apps/harness, apps/mixed-mode).
LLM_PROVIDER=mock            # mock | openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Harness limits
HARNESS_MAX_STEPS=6

# OpenUI packages run a telemetry postinstall; disable it with either of these before `pnpm install`
OPENUI_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
